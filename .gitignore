# Local environments, build products, caches and private migration baseline
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp*/
.ruff_cache/
*.egg-info/
build/
dist/
.migration-private/
.env
.env.*
*.key
*.pem
# Never overwrite historical result directories; new local experiments live here.
results/local/

# Public template contains no credential.
!.env.example

# Stage-seven release evidence allowlist; other local runs remain on disk.
/results/stage7_langgraph/*
!/results/stage7_langgraph/live-study-001/
!/results/stage7_langgraph/live-study-002/
!/results/stage7_langgraph/preflight-006/
!/results/stage7_langgraph/v1.1.0-audit/
